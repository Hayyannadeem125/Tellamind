# Formspree endpoint used by contact, service, and Snapchat inquiry forms.
# This endpoint is public in the browser bundle; GitHub Pages reads the same value
# from the VITE_FORMSPREE_ENDPOINT Actions variable during the production build.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/maeqkwwg

# Optional Google Apps Script intake /exec URL; takes precedence over Formspree.
# Deploy integrations/client-intake first and verify it before setting this value.
VITE_INQUIRY_WEBHOOK_URL=

# Optional: owner-managed meeting scheduling URL (Calendly or similar)
VITE_BOOKING_URL=

# Add only active, owner-controlled public profile URLs. Blank values hide the links.
VITE_LINKEDIN_URL=
VITE_INSTAGRAM_URL=
VITE_FACEBOOK_URL=

# Add the purchased, verified canonical domain before launch, e.g. https://www.example.com
VITE_SITE_URL=
